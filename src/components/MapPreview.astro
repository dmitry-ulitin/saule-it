---
/**
 * Lightweight map placeholder: a drawn street scheme with a pin that opens Google Maps.
 * No third-party scripts or cookies are loaded, so no cookie consent is needed for it.
 * To show a real interactive map later, replace this component with an <iframe> embed.
 */
import { company } from '../data/site';

interface Props {
  alt: string;
  openLabel: string;
}

const { alt, openLabel } = Astro.props;
---

<a class="map" href={company.mapUrl} target="_blank" rel="noopener">
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt}>
    <rect width="400" height="300" fill="#EEF0F4"></rect>
    <path d="M0 0 L400 0 L400 40 C300 60 220 25 140 50 C80 68 30 50 0 58 Z" fill="#DCE5EE"></path>
    <g stroke="#FFFFFF" stroke-width="7" fill="none" stroke-linecap="round">
      <path d="M-10 150 C120 130 260 175 410 140"></path><path d="M140 50 L200 310"></path><path d="M30 310 L330 60"></path>
    </g>
    <g stroke="#FFFFFF" stroke-width="3" fill="none">
      <path d="M0 100 L400 92"></path><path d="M0 220 L400 240"></path><path d="M70 60 L60 300"></path>
      <path d="M300 45 L330 300"></path><path d="M250 110 L370 210"></path>
    </g>
    <rect x="300" y="240" width="70" height="50" rx="8" fill="#DCE8DE"></rect>
    <rect x="30" y="110" width="50" height="28" rx="6" fill="#DCE8DE"></rect>
    <g transform="translate(200 140)">
      <path d="M0 -38 C-14 -38 -22 -28 -22 -16 C-22 0 0 18 0 18 C0 18 22 0 22 -16 C22 -28 14 -38 0 -38 Z" fill="#5A1F73"></path>
      <circle cx="0" cy="-16" r="7" fill="#FFFFFF"></circle>
    </g>
    <text x="200" y="186" text-anchor="middle" font-family="Manrope Variable, sans-serif" font-size="16" font-weight="700" fill="#3A3550">{company.city}</text>
  </svg>
  <span class="open">{openLabel} ↗</span>
</a>

<style>
  .map { position: relative; display: block; min-height: 240px; height: 100%; border-radius: var(--radius-lg); overflow: hidden; background: #eef0f4; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .open {
    position: absolute; right: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px;
    background: var(--c-white); font-size: 13px; font-weight: 700; color: var(--c-brand);
    box-shadow: 0 2px 8px rgb(30 10 50 / 0.12);
  }
  .map:hover .open { background: var(--c-bg-hover); }
</style>
