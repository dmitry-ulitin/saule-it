---
/**
 * Static map of the office with a pin that opens Google Maps.
 * The image is a local snapshot of OpenStreetMap centred on the office (pin = image centre),
 * so no third-party scripts or cookies are loaded and no cookie consent is needed for it.
 * If the office moves, regenerate src/assets/images/map-office.jpg for the new address.
 */
import { Image } from 'astro:assets';
import { company } from '../data/site';
import mapImage from '../assets/images/map-office.jpg';

interface Props {
  alt: string;
  openLabel: string;
}

const { alt, openLabel } = Astro.props;
---

<a class="map" href={company.mapUrl} target="_blank" rel="noopener">
  <Image src={mapImage} alt={alt} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 480px" />
  <svg class="pin" viewBox="-22 -38 44 56" aria-hidden="true">
    <path d="M0 -38 C-14 -38 -22 -28 -22 -16 C-22 0 0 18 0 18 C0 18 22 0 22 -16 C22 -28 14 -38 0 -38 Z" fill="#5A1F73"></path>
    <circle cx="0" cy="-16" r="7" fill="#FFFFFF"></circle>
  </svg>
  <span class="credit">© OpenStreetMap</span>
  <span class="open">{openLabel} ↗</span>
</a>

<style>
  .map { position: relative; display: block; min-height: 240px; height: 100%; border-radius: var(--radius-lg); overflow: hidden; background: #eef0f4; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* the pin's tip sits exactly at the image centre */
  .pin { position: absolute; left: 50%; top: 50%; width: 44px; height: 56px; transform: translate(-50%, -68%); filter: drop-shadow(0 2px 4px rgb(30 10 50 / 0.35)); }
  .credit {
    position: absolute; left: 0; bottom: 0; padding: 2px 6px; border-top-right-radius: 6px;
    background: rgb(255 255 255 / 0.8); font-size: 11px; color: var(--c-text-3);
  }
  .open {
    position: absolute; right: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px;
    background: var(--c-white); font-size: 13px; font-weight: 700; color: var(--c-brand);
    box-shadow: 0 2px 8px rgb(30 10 50 / 0.12);
  }
  .map:hover .open { background: var(--c-bg-hover); }
</style>
