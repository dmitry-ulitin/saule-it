---
/** Title band at the top of inner pages (Services, Contact): text on the left, photo fading in on the right. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  image: ImageMetadata;
}

const { eyebrow, title, intro, image } = Astro.props;
---

<section class="page-header">
  <div class="photo" aria-hidden="true">
    <Image src={image} alt="" widths={[480, 800, 1200]} sizes="(max-width: 720px) 100vw, 50vw" loading="eager" />
  </div>
  <div class="container text">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
</section>

<style>
  .page-header { position: relative; overflow: hidden; background: var(--c-bg-soft); }
  .photo { position: absolute; inset: 0 0 0 auto; width: 48%; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, var(--c-bg-soft) 0%, rgb(247 245 250 / 0) 45%);
  }
  .text { position: relative; display: flex; flex-direction: column; gap: 12px; padding-block: 64px 56px; }
  h1 { font-size: clamp(36px, 5vw, 52px); font-weight: 800; letter-spacing: -0.03em; max-width: 52%; }
  p { font-size: 18px; color: var(--c-text-2); max-width: 46%; }

  @media (max-width: 720px) {
    .photo { position: relative; inset: auto; width: 100%; height: 180px; }
    .photo::after { background: linear-gradient(0deg, var(--c-bg-soft) 0%, rgb(247 245 250 / 0) 50%); }
    .text { padding-block: 8px 40px; }
    h1, p { max-width: none; }
  }
</style>
