---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import headerImage from '../../assets/images/header-services.jpg';
import { serviceIds, serviceVisuals } from '../../data/services';
import { localeStaticPaths, localizedPath, useTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} page="services">
  <PageHeader eyebrow={t.services.eyebrow} title={t.services.title} intro={t.services.intro} image={headerImage} />

  <section class="container list">
    {
      serviceIds.map((id, i) => {
        const item = t.services.items[id];
        return (
          <article id={id} class="service">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="tile">
              <Icon name={serviceVisuals[id].icon} size={26} />
            </span>
            <div class="body">
              <h2>{item.title}</h2>
              <ul>
                {item.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
            <Image
              class="photo"
              src={serviceVisuals[id].image}
              alt={item.imageAlt}
              width={240}
              height={180}
              densities={[1, 2]}
            />
          </article>
        );
      })
    }
  </section>

  <section class="container cta">
    <a class="btn" href={localizedPath(lang, 'contact')} data-cta="discuss">
      {t.cta.discuss}
      <Icon name="arrow" size={18} strokeWidth={2} />
    </a>
  </section>
</BaseLayout>

<style>
  .list { padding-block: 24px 24px; }
  .service {
    display: flex; flex-wrap: wrap; align-items: flex-start; gap: 24px 32px;
    padding-block: 36px; border-bottom: 1px solid var(--c-border-2);
    scroll-margin-top: 16px;
  }
  .num { flex: 0 0 40px; font-size: 18px; font-weight: 600; color: var(--c-muted); padding-top: 14px; }
  .tile {
    flex: 0 0 56px; width: 56px; height: 56px; border-radius: 10px; background: var(--c-brand-soft); color: var(--c-brand);
    display: flex; align-items: center; justify-content: center;
  }
  .body { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 14px; padding-top: 12px; }
  h2 { font-size: 22px; font-weight: 700; line-height: 1.3; }
  ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 15px; color: var(--c-text-2); }
  .service :global(.photo) { flex: 0 0 240px; width: 240px; height: 180px; border-radius: 10px; object-fit: cover; }
  .cta { padding-block: 32px 88px; }

  @media (max-width: 720px) {
    .num { display: none; }
    .service :global(.photo) { order: -1; flex-basis: 100%; width: 100%; height: 200px; }
  }
</style>
