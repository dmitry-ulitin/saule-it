---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../components/icons';
import hero from '../../assets/images/hero.jpg';
import { serviceIds, serviceVisuals } from '../../data/services';
import { localeStaticPaths, localizedPath, useTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const whyIcons: IconName[] = ['globe', 'people', 'layers', 'sliders'];
---

<BaseLayout lang={lang} page="home">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1>{t.home.heroTitle} <span>{t.home.heroAccent}</span></h1>
        <p class="lead">{t.home.heroText}</p>
        <p class="geo">{t.home.heroGeo}</p>
        <div class="actions">
          <a class="btn" href={localizedPath(lang, 'contact')} data-cta="discuss">
            {t.cta.discuss}
            <Icon name="arrow" size={18} strokeWidth={2} />
          </a>
        </div>
      </div>
      <div class="hero-photo">
        <Image
          src={hero}
          alt={t.home.heroImageAlt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 45vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="container services">
    <div class="section-head">
      <h2 class="section-title">{t.home.servicesTitle}</h2>
      <a class="link-arrow" href={localizedPath(lang, 'services')}>
        {t.cta.allServices}
        <Icon name="arrow" size={18} strokeWidth={2} />
      </a>
    </div>
    <ul class="cards">
      {
        serviceIds.map((id) => (
          <li>
            <a class="card" href={localizedPath(lang, 'services', id)}>
              <span class="tile">
                <Icon name={serviceVisuals[id].icon} size={26} />
              </span>
              <span class="card-title">{t.services.items[id].short}</span>
              <Icon name="arrow" size={18} strokeWidth={2} class="card-arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Why choose us -->
  <section class="container why">
    <h2 class="section-title">{t.home.whyTitle}</h2>
    <ul class="why-list">
      {
        t.home.why.map((text, i) => (
          <li>
            <span class="circle">
              <Icon name={whyIcons[i]!} size={26} />
            </span>
            {text}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- How we work -->
  <section class="how">
    <div class="container">
      <h2 class="section-title">{t.home.howTitle}</h2>
      <ol class="steps">
        {
          t.home.steps.map((step, i) => (
            <li>
              <span class="num" aria-hidden="true">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero { background: var(--c-bg-soft); overflow: hidden; }
  .hero-inner { display: flex; flex-wrap: wrap; align-items: stretch; gap: 32px; }
  .hero-text { flex: 1 1 520px; display: flex; flex-direction: column; gap: 24px; padding-block: 80px; }
  h1 { font-size: clamp(36px, 5vw, 56px); line-height: 1.08; font-weight: 800; letter-spacing: -0.03em; color: #000; }
  .lead { font-size: 18px; line-height: 1.6; color: var(--c-text-2); max-width: 600px; }
  .geo { font-size: 15px; line-height: 1.6; color: var(--c-text-3); max-width: 600px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 8px; }
  .actions .btn { min-height: 54px; }
  /* the photo bleeds to the right edge of the window */
  .hero-photo {
    flex: 1 1 420px; position: relative; min-height: 440px;
    margin-right: calc(-1 * (max(0px, (100vw - var(--container)) / 2) + var(--gutter)));
  }
  .hero-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-photo::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, var(--c-bg-soft) 0%, rgb(247 245 250 / 0) 30%);
  }

  /* Services */
  .services { padding-block: 72px 32px; }
  .section-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .card {
    position: relative; display: flex; flex-direction: column; gap: 18px; height: 100%; min-height: 150px;
    padding: 24px; border-radius: var(--radius); background: var(--c-bg-soft); color: var(--c-text);
    transition: background-color .2s;
  }
  .card:hover { background: var(--c-bg-hover); color: var(--c-text); }
  .tile {
    width: 52px; height: 52px; border-radius: 10px; background: var(--c-brand-soft); color: var(--c-brand);
    display: flex; align-items: center; justify-content: center;
  }
  .card-title { font-size: 17px; font-weight: 700; line-height: 1.35; padding-right: 24px; }
  .card :global(.card-arrow) { position: absolute; top: 24px; right: 22px; color: var(--c-brand); }

  /* Why */
  .why { padding-block: 56px; }
  .why-list {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px 48px;
    max-width: 900px; margin: 32px 0 0; padding: 0; list-style: none;
  }
  .why-list li { display: flex; align-items: center; gap: 18px; font-size: 17px; font-weight: 600; line-height: 1.4; }
  .circle {
    flex: 0 0 56px; width: 56px; height: 56px; border-radius: 50%; background: var(--c-brand-soft); color: var(--c-brand);
    display: flex; align-items: center; justify-content: center;
  }

  /* How we work */
  .how { background: var(--c-bg-soft); padding-block: 72px 88px; }
  .steps {
    position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 24px;
    margin: 40px 0 0; padding: 0; list-style: none;
  }
  .steps::before {
    content: ''; position: absolute; left: 12.5%; right: 12.5%; top: 24px; height: 2px; background: var(--c-brand-line);
  }
  .steps li { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .num {
    width: 48px; height: 48px; border-radius: 50%; background: var(--c-brand-soft); color: var(--c-brand);
    border: 4px solid var(--c-bg-soft); display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 18px;
  }
  .steps h3 { margin-top: 6px; font-size: 18px; font-weight: 700; }
  .steps p { font-size: 15px; color: var(--c-text-3); max-width: 240px; }

  @media (max-width: 900px) {
    .hero-text { padding-block: 48px 8px; }
    .hero-photo { flex-basis: 100%; min-height: 280px; margin-inline: calc(-1 * var(--gutter)); }
    .hero-photo::after { background: linear-gradient(180deg, var(--c-bg-soft) 0%, rgb(247 245 250 / 0) 30%); }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps { grid-template-columns: 1fr 1fr; }
    .steps::before { display: none; }
  }
  @media (max-width: 520px) {
    .cards, .steps { grid-template-columns: 1fr; }
  }
</style>
