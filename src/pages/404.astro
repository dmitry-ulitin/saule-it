---
/** Shown by the hosting for any unknown URL. One page for all languages, so it lists all three. */
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { locales, localizedPath, useTranslations } from '../i18n';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — Saule IT Services</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body>
    <main class="container wrap">
      <p class="code">404</p>
      <ul>
        {
          locales.map((l) => {
            const t = useTranslations(l).notFound;
            return (
              <li lang={l}>
                <h1>{t.title}</h1>
                <p>{t.text}</p>
                <a href={localizedPath(l, 'home')}>{t.back} →</a>
              </li>
            );
          })
        }
      </ul>
    </main>
  </body>
</html>

<style>
  .wrap { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; gap: 24px; padding-block: 64px; }
  .code { font-size: 96px; font-weight: 800; color: var(--c-brand); line-height: 1; }
  ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; margin: 0; padding: 0; list-style: none; }
  h1 { font-size: 22px; margin-bottom: 6px; }
  p { color: var(--c-text-3); margin-bottom: 10px; }
  a { font-weight: 700; }
</style>
