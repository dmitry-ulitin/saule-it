---
/**
 * Common page frame: <head> with SEO tags, header, footer.
 * Every page in src/pages/[lang]/ is wrapped in this layout.
 */
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import ogImage from '../assets/images/hero.jpg';
import logo from '../assets/images/logo.png';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { pageTransition } from '../styles/transitions';
import {
  defaultLocale, htmlLang, locales, localizedPath, ogLocale, useTranslations,
  type Locale, type PageKey,
} from '../i18n';
import { company } from '../data/site';

interface Props {
  lang: Locale;
  page: PageKey;
  /** Hide the page from search engines (e.g. a draft privacy policy). */
  noindex?: boolean;
}

const { lang, page, noindex = false } = Astro.props;
const t = useTranslations(lang);
const { title, description } = t.meta[page];

const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(localizedPath(lang, page));
const alternates = locales.map((l) => ({ lang: l, href: abs(localizedPath(l, page)) }));
const xDefault = abs(localizedPath(defaultLocale, page));

const og = await getImage({ src: ogImage, width: 1200, format: 'jpg' });
const logoPng = await getImage({ src: logo, format: 'png' });

// Schema.org: Organization + ContactPoint (from the SEO brief, section 5)
const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': abs('/#organization'),
  name: company.name,
  url: abs(localizedPath(lang, 'home')),
  logo: abs(logoPng.src),
  image: abs(og.src),
  email: company.email,
  sameAs: [`https://t.me/${company.telegram}`],
  address: { '@type': 'PostalAddress', streetAddress: company.streetAddress, postalCode: company.postalCode, addressLocality: company.city, addressCountry: company.countryCode },
  areaServed: company.areaServed.map((name) => ({ '@type': 'Country', name })),
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: company.email,
    availableLanguage: ['English', 'Russian', 'Estonian'],
  },
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#5a1f73" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />

    <!--
      Smooth page transitions: links load the next page in the background and swap only what changed,
      without a full reload. Header and footer stay in place; <main> fades/slides (src/styles/transitions.ts).
      Browsers without View Transitions support get the same effect via Astro's fallback animation.
    -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <Header lang={lang} page={page} />
    <main id="main" transition:name="page" transition:animate={pageTransition}>
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    <CookieConsent lang={lang} />
  </body>
</html>
