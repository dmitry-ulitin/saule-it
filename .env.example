# Copy this file to ".env" and fill in the values.

# Access key for the contact form (https://web3forms.com — free, enter info@sauleit.com to get a key).
# The key is public by design (it only allows sending to your own mailbox).
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to switch analytics and the cookie banner off.
PUBLIC_GA4_ID=
